# Set to qwen. Survey/Judge/Blog use provider-specific defaults
# unless their role model variables below are explicitly set.
QWENSCI_LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Only required when running src/agents/survey_agent/utils/step2v2.py directly.
SURVEY_AGENT_API_KEY=
SURVEY_AGENT_API_URL=
SURVEY_AGENT_MODEL_NAME=glm-5
SURVEY_AGENT_DATA_DIR=
IDEA_LLM_MODEL=
IDEA_GENERATION_MODEL=
IDEA_EVALUATION_MODEL=
EXPERIMENT_LLM_PROVIDER=
EXPERIMENT_LLM_MODEL=
EXPERIMENT_PLANNER_MODEL=
EXPERIMENT_WORKER_MODEL=
EXPERIMENT_REVIEWER_MODEL=
EXPERIMENT_MASTER_MODEL=
MEMORY_LLM_PROVIDER=
MEMORY_LLM_MODEL=

# Qwen vision review and DashScope image generation.
VISION_LLM_PROVIDER=qwen
VISION_QUALITY_MODEL=qwen3-vl-plus
VISION_BATCH_MODEL=qwen3-vl-flash
IMAGE_GENERATION_PROVIDER=qwen
IMAGE_ACADEMIC_FIGURE_MODEL=wan2.7-image-pro
IMAGE_TEXT_RICH_FIGURE_MODEL=qwen-image-3.0-pro
IMAGE_DRAFT_MODEL=z-image-turbo
DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

SURVEY_LLM_MODEL=
SURVEY_JUDGE_PROVIDER=
SURVEY_JUDGE_MODEL=
BLOG_LLM_PROVIDER=
BLOG_LLM_MODEL=
# Optional contact addresses for literature providers. OpenAlex works without
# one; Unpaywall DOI-to-PDF resolution is enabled only when one is supplied.
