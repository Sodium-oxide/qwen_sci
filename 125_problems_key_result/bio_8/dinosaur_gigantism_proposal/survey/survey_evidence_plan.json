    {"id": "SH3", "statement": "Pneumatic anatomy relaxed selected structural or respiratory constraints.", "required_evidence": ["pneumaticity coding", "axial morphology", "extant archosaur analogue"], "allowed_claim": "anatomical constraint hypothesis"},
    {"id": "SH4", "statement": "Growth and reproduction made very large adult size evolutionarily accessible.", "required_evidence": ["histology", "ontogenetic stage", "life-history comparison"], "allowed_claim": "life-history enabling hypothesis"},
    {"id": "SH5", "statement": "Ecology modulated opportunities and limits rather than supplying a universal independent cause.", "required_evidence": ["stratigraphy", "palaeoflora or facies", "geographic and sampling controls"], "allowed_claim": "context-dependent moderation"}
