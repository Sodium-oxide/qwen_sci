  "topic": "Why did dinosaurs grow to be so big?",
  "scientific_reframing": "Which interacting anatomical, life-history, physiological, and ecological conditions enabled repeated evolution of extreme body mass in sauropods, and which conditions are necessary, sufficient, or only correlated with gigantism?",
  "evidence_policy": {
    "direct_evidence": ["fossil morphology", "bone histology", "dental incremental lines", "body-mass scaling datasets", "dated phylogenies"],
    "proxy_evidence": ["postcranial pneumaticity", "feeding envelope", "palaeoenvironmental productivity"],
    "forbidden_upgrades": [
      "Do not infer measured metabolic rate, air-flow direction, or heat dissipation directly from pneumatic bone.",
      "Do not infer realized daily energy intake from neck length or tooth turnover alone.",
      "Do not present a reconstructed growth curve as observed data when it is an inferred model output."
    ]
  },
  "subhypotheses": [
    {"id": "SH1", "statement": "Repeated extreme body-mass shifts are phylogenetically and temporally structured.", "required_evidence": ["time-calibrated phylogeny", "mass estimates with intervals"], "allowed_claim": "macroevolutionary pattern"},
