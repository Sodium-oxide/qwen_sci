        "paper_evidence": [
          {
            "abstract": "Abstract Imaging large fields of view while preserving high-resolution structural information remains a challenge in low-dose cryo-electron tomography. Here, we present robust tools for montage electron tomography tailored for vitrified specimens. The integration of correlative cryo-fluorescence microscopy, focused-ion beam milling, and micropatterning produces contextual three-dimensional architecture of cells. Montage tilt series may be processed in their entirety or as individual tiles suitable for sub-tomogram averaging, enabling efficient data processing and analysis.",
            "paper_id": "W4206216780",
            "title": "Correlative cryogenic montage electron tomography for comprehensive in-situ whole-cell structural studies"
          }
