{
  "schema_version": "survey_evidence_plan_v1",
  "research_question": "Under what conditions could pig-to-human xenotransplantation safely and equitably relieve, rather than merely promise to relieve, donor-organ shortage?",
  "scope": {
    "included": ["solid-organ pig-to-human xenotransplantation", "kidney human feasibility", "cardiac nonhuman-primate durability", "immune/coagulation/infection mechanisms", "regulatory and deployment constraints"],
    "excluded": ["clinical recommendations", "new human or animal experimentation", "operational genetic engineering", "organ procurement or transplant procedures"]
  },
  "evidence_levels": {
    "E1": "Direct human evidence with bounded observation window",
    "E2": "Nonhuman-primate in vivo evidence",
    "E3": "Mechanistic or translational review evidence",
    "E4": "Regulatory and governance evidence"
  },
  "subhypotheses": [
    {
      "id": "H1",
      "claim": "A genetically modified pig graft can exhibit measurable short-term function in a human-relevant setting.",
      "allowed_sources": ["S1"],
      "allowed_language": "short-term human feasibility",
      "forbidden_language": "long-term living-recipient efficacy or routine clinical availability"
    },
    {
      "id": "H2",
      "claim": "Durable function requires coupled control of immune injury, coagulation/physiology, and infectious risk.",
      "allowed_sources": ["S2", "S3", "S4", "S5"],
      "allowed_language": "technical plausibility and unresolved mechanisms",
      "forbidden_language": "barriers have been eliminated"
    },
    {
      "id": "H3",
      "claim": "Shortage relief is a system outcome, not a graft-count outcome.",
      "allowed_sources": ["S3", "S5", "S6", "S7"],
      "allowed_language": "conditional deployment potential",
      "forbidden_language": "xenotransplantation will solve organ shortage"
    },
    {
      "id": "H4",
      "claim": "Longitudinal surveillance, quality systems, regulation, and equity are readiness thresholds.",
      "allowed_sources": ["S5", "S6", "S7"],
      "allowed_language": "governance is integral to translation",
      "forbidden_language": "infection or equity issues are solved"
    }
  ],
  "sources": [
    {"id": "S1", "doi": "10.1056/NEJMoa2120238", "type": "primary study", "level": "E1", "cross_validated": true, "boundary": "brain-dead human recipients; 54-hour observation"},
    {"id": "S2", "doi": "10.1111/xen.12744", "type": "primary preclinical study", "level": "E2", "cross_validated": true, "boundary": "pig-to-baboon cardiac model"},
    {"id": "S3", "doi": "10.3389/fimmu.2022.1031185", "type": "mechanistic review", "level": "E3", "cross_validated": true, "boundary": "not an outcome trial"},
    {"id": "S4", "doi": "10.3389/fimmu.2022.928173", "type": "mechanistic review", "level": "E3", "cross_validated": true, "boundary": "not an outcome trial"},
    {"id": "S5", "doi": "10.3201/eid3007.240273", "type": "infectious disease review", "level": "E4", "cross_validated": true, "boundary": "risk-management analysis, not proof of zero risk"},
    {"id": "S6", "doi": "10.1111/xen.12513", "type": "WHO regulatory consultation", "level": "E4", "cross_validated": true, "boundary": "governance guidance, not efficacy evidence"},
    {"id": "S7", "doi": "10.1016/j.jacbts.2022.05.003", "type": "clinical-translational review", "level": "E3", "cross_validated": true, "boundary": "cardiac focus and review-level evidence"}
  ]
}
