{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-zhikan.local/schemas/task_envelope_v1.json",
  "title": "TaskEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "run_id", "task_type", "owner_module", "required_state", "input_artifacts", "expected_output_schemas", "idempotency_key", "created_at"],
  "properties": {
    "schema_version": {"const": "task_envelope_v1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "task_type": {"enum": ["VALIDATE_RESEARCH_BRIEF", "BIND_CASE", "DRAFT_PROTOCOL", "REQUEST_APPROVAL", "FREEZE_PROTOCOL", "BUILD_RESULT_BUNDLE", "NO_OP"]},
    "owner_module": {"enum": ["M00", "M01", "M15", "M17"]},
    "required_state": {"enum": ["BRIEF_DRAFT", "BRIEF_VALIDATED", "CASE_BOUND", "PROTOCOL_DRAFT", "APPROVAL_PENDING", "PROTOCOL_FROZEN"]},
    "input_artifacts": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "expected_output_schemas": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 240},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "content_hash", "relative_path"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1}, "artifact_type": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "relative_path": {"type": "string", "minLength": 1}
      }
    }
  }
}

