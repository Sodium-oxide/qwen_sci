{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-zhikan.local/schemas/validation_report_v1.json",
  "title": "ValidationReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "run_id", "candidate_model_hash", "case_manifest_hash", "lens_spec_hash", "verdict", "checks", "errors", "created_at", "validator_version"],
  "properties": {
    "schema_version": {"const": "validation_report_v1"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "candidate_model_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "case_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lens_spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verdict": {"enum": ["PASS", "HARD_REJECT", "BLOCKED"]},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "created_at": {"type": "string", "format": "date-time"},
    "validator_version": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "unit", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}, "tolerance": {"type": "number", "minimum": 0},
        "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "stage", "status", "metrics"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1}, "stage": {"enum": ["V1", "V2", "V3"]},
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "code", "severity", "message", "field_path", "recoverable", "origin_module"],
      "properties": {
        "schema_version": {"const": "structured_error_v1"},
        "code": {"enum": ["UNIT_MISMATCH", "STRUCTURE_INVALID", "ALGEBRAIC_CLOSURE_MISSING", "POWER_BALANCE_VIOLATION", "NUMERICAL_DIVERGENCE", "CONTRACT_VALIDATION_FAILED", "ARTIFACT_INTEGRITY_FAILED", "APPROVAL_REQUIRED", "INTERNAL_ERROR"]},
        "severity": {"enum": ["INFO", "WARNING", "ERROR", "FATAL"]}, "message": {"type": "string", "minLength": 1},
        "field_path": {"type": "string"}, "recoverable": {"type": "boolean"}, "origin_module": {"type": "string", "pattern": "^M[0-9]{2}$"},
        "equation_id": {"type": "string"}, "variable_id": {"type": "string"},
        "expected": {"type": ["string", "number", "boolean", "null"]}, "observed": {"type": ["string", "number", "boolean", "null"]}
      }
    }
  }
}

