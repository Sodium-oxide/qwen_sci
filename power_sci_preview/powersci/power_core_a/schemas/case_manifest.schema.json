{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-zhikan.local/schemas/case_manifest_v1.json",
  "title": "CaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "case_version", "benchmark_level", "name", "equation_ir_ref", "resources", "initial_conditions", "parameters", "time_domain", "random_seed", "provenance"],
  "properties": {
    "schema_version": {"const": "case_manifest_v1"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "case_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "benchmark_level": {"enum": ["B0", "B1", "B2"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 240},
    "equation_ir_ref": {"$ref": "#/$defs/contract_ref"},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "initial_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/value"}},
    "parameters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/value"}},
    "time_domain": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "stop", "step", "unit"],
      "properties": {
        "start": {"type": "number"}, "stop": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0}, "unit": {"type": "string", "minLength": 1}
      }
    },
    "random_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "license", "created_at", "created_by"],
      "properties": {
        "source": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "contract_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_name", "schema_version", "artifact_id", "content_hash"],
      "properties": {
        "schema_name": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1}, "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id", "role", "uri", "media_type", "content_hash"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1}, "role": {"enum": ["input", "truth", "reference"]},
        "uri": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "value": {
      "type": "object", "additionalProperties": false,
      "required": ["variable_id", "value", "unit"],
      "properties": {"variable_id": {"type": "string", "minLength": 1}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}}
    }
  }
}

