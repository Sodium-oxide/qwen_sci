{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-zhikan.local/schemas/lens_spec_v2.json",
  "title": "LensSpecV2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "lens_id", "lens_version", "name", "input_units_preserved", "coordinate_metadata_preserved", "reference_metadata_preserved", "random_seed", "transforms"],
  "properties": {
    "schema_version": {"const": "lens_spec_v2"}, "lens_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "lens_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "name": {"type": "string", "minLength": 1},
    "input_units_preserved": {"const": true}, "coordinate_metadata_preserved": {"const": true}, "reference_metadata_preserved": {"const": true},
    "random_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "transforms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transform"}}
  },
  "$defs": {
    "transform": {"type": "object", "additionalProperties": false, "required": ["order", "type", "targets"], "properties": {
      "order": {"type": "integer", "minimum": 0}, "type": {"enum": ["IDENTITY", "RESAMPLE", "ADD_GAUSSIAN_NOISE", "DROP_SAMPLES", "AFFINE"]},
      "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0}, "anti_alias": {"type": "boolean"}, "noise_std": {"type": "number", "minimum": 0},
      "noise_unit": {"type": "string", "minLength": 1}, "missing_rate": {"type": "number", "minimum": 0, "maximum": 1}, "scale": {"type": "number"}, "offset": {"type": "number"},
      "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    }}
  }
}
