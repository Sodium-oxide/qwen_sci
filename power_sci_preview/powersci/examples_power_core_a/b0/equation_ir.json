  "variables": [
    {"variable_id": "delta", "symbol": "delta", "role": "state", "unit": "rad", "coordinate": "rotor_electrical_angle", "description": "Rotor electrical angle relative to the synchronous reference", "per_unit": {"enabled": false}},
    {"variable_id": "omega", "symbol": "Delta_omega", "role": "state", "unit": "pu", "coordinate": "synchronous_speed_deviation", "description": "Per-unit rotor speed deviation", "per_unit": {"enabled": true, "base_quantity": "angular_speed", "base_value": 376.99111843077515, "base_unit": "rad/s"}},
    {"variable_id": "omega_b", "symbol": "omega_b", "role": "parameter", "unit": "rad/s", "coordinate": "synchronous_base", "per_unit": {"enabled": false}},
    {"variable_id": "H", "symbol": "H", "role": "parameter", "unit": "s", "coordinate": "machine_inertia", "per_unit": {"enabled": false}},
    {"variable_id": "D", "symbol": "D", "role": "parameter", "unit": "pu", "coordinate": "machine_damping", "per_unit": {"enabled": true, "base_quantity": "power_over_speed", "base_value": 1.0, "base_unit": "pu"}},
    {"variable_id": "P_m", "symbol": "P_m", "role": "input", "unit": "pu", "coordinate": "mechanical_power", "per_unit": {"enabled": true, "base_quantity": "active_power", "base_value": 100.0, "base_unit": "MVA"}},
    {"variable_id": "P_e", "symbol": "P_e", "role": "input", "unit": "pu", "coordinate": "electrical_air_gap_power", "per_unit": {"enabled": true, "base_quantity": "active_power", "base_value": 100.0, "base_unit": "MVA"}}
  ],
  "equations": [
    {
      "equation_id": "swing_angle",
