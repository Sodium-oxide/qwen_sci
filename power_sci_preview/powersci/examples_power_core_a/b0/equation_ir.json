      "description": "Electrical rotor-angle kinematics",
      "residual": {
        "node": "operator", "operator": "subtract", "arguments": [
          {"node": "derivative", "variable_id": "delta", "with_respect_to": "t"},
          {"node": "operator", "operator": "multiply", "arguments": [
